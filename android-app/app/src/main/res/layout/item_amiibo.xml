<?xml version="1.0" encoding="utf-8"?>
<!-- Library/database row, mirroring the web page's .item / .dbcard:
     rounded #141a22 row, box-art thumb, title + two muted lines, and an
     outline chip (NTAG215 / V3 · I2C / INVALID / BIN) on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/item_row"
    android:paddingStart="12dp"
    android:paddingEnd="11dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="@drawable/thumb"
        android:clipToOutline="true"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:singleLine="true"
            android:ellipsize="middle"/>

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tag_violet"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.07"
        android:textAllCaps="false"
        android:textColor="@color/violet"
        android:visibility="gone"/>
</LinearLayout>
